    echo -e "   - Open your home router admin page (usually http://192.168.1.1 or 192.168.0.1)"
    echo -e "   - Navigate to ${C_YELLOW}Port Forwarding${C_RESET} or ${C_YELLOW}Virtual Server${C_RESET}"
