            ;;
    esac
}

# Security & Fail2ban Audit
cmd_security() {
    local action="${1:-audit}"
    local target="$2"

    case "$action" in
        audit)
            echo -e "${C_WHITE}${C_BOLD}=== SERVER SECURITY AUDIT ===${C_RESET}\n"
            # Root login status
            local root_ssh="Unknown"
            if [ -f /etc/ssh/sshd_config ]; then
                if grep -E '^[[:space:]]*PermitRootLogin[[:space:]]+no' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null | grep -q "no"; then
                    root_ssh="${C_GREEN}Disabled (Secure)${C_RESET}"
                else
                    root_ssh="${C_YELLOW}Enabled or Default${C_RESET}"
                fi
            fi
            echo -e "Root SSH Login: $root_ssh"

            # Firewall status
            local fw_status="Disabled"
            if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "Status: active"; then
                fw_status="${C_GREEN}UFW Active${C_RESET}"
            elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -q "running"; then
                fw_status="${C_GREEN}firewalld Active${C_RESET}"
            fi
            echo -e "Firewall Defense: $fw_status"

            # Fail2ban status
            if command -v fail2ban-client >/dev/null 2>&1 && systemctl is-active --quiet fail2ban 2>/dev/null; then
                local banned_count
                banned_count=$(fail2ban-client status sshd 2>/dev/null | grep "Currently banned:" | awk '{print $NF}' || echo "0")
                echo -e "Fail2ban SSH Jail: ${C_GREEN}Active${C_RESET} (${banned_count} IP(s) currently banned)"
            else
                echo -e "Fail2ban SSH Jail: ${C_RED}Inactive${C_RESET}"
            fi

            # Check open listening ports
            echo -e "\n${C_BOLD}Listening Network Ports:${C_RESET}"
            ss -tuln 2>/dev/null | grep -E 'LISTEN' | awk '{print "  " $1 "\t" $5}' || netstat -tuln 2>/dev/null | grep -E 'LISTEN' | awk '{print "  " $1 "\t" $4}'
            ;;
        banned)
            if command -v fail2ban-client >/dev/null 2>&1; then
                echo -e "${C_BOLD}Currently Banned IP Addresses (SSHD Jail):${C_RESET}"
                fail2ban-client status sshd 2>/dev/null | grep "Banned IP list:" | sed 's/^[ \t]*Banned IP list:[ \t]*/  /' || echo "  None"
            else
                echo -e "${C_YELLOW}Fail2ban is not installed.${C_RESET}"
            fi
            ;;
        unban)
            require_root
            if [ -z "$target" ]; then
                echo -e "${C_RED}[!] Usage: serverctl security unban <ip_address>${C_RESET}"
                exit 1
            fi
            fail2ban-client set sshd unbanip "$target"
            echo -e "${C_GREEN}[✓] IP ${target} unbanned.${C_RESET}"
            ;;
        *)
            echo -e "${C_RED}[!] Usage: serverctl security [audit|banned|unban <ip>]${C_RESET}"
            ;;
    esac
}

# Webhook Alert Setup
cmd_notify() {
    local action="${1:-test}"
    mkdir -p "$CONFIG_DIR"

    case "$action" in
        setup)
            require_root
            echo -e "${C_BOLD}=== Webhook Alert Setup (Discord / Telegram) ===${C_RESET}"
            read -r -p "Enter Discord Webhook URL (or press Enter to skip): " discord_url
            read -r -p "Enter Telegram Bot Token (or press Enter to skip): " tg_token
            read -r -p "Enter Telegram Chat ID (or press Enter to skip): " tg_chat

            cat > "$NOTIFY_CONFIG" << EOF
DISCORD_WEBHOOK="${discord_url}"
TELEGRAM_BOT_TOKEN="${tg_token}"
TELEGRAM_CHAT_ID="${tg_chat}"
EOF
            chmod 600 "$NOTIFY_CONFIG"
            echo -e "${C_GREEN}[✓] Notification config saved to ${NOTIFY_CONFIG}.${C_RESET}"
            ;;
        test)
            if [ ! -f "$NOTIFY_CONFIG" ]; then
                echo -e "${C_YELLOW}[!] No webhook configured. Run: sudo serverctl notify setup${C_RESET}"
                exit 0
            fi
            # shellcheck source=/dev/null
            source "$NOTIFY_CONFIG"
            local msg="[server-my-pc] Test alert from $(hostname) at $(date '+%Y-%m-%d %H:%M:%S'). Server is ONLINE and 24/7 active."
            if [ -n "$DISCORD_WEBHOOK" ]; then
                curl -s -H "Content-Type: application/json" -X POST -d "{\"content\": \"$msg\"}" "$DISCORD_WEBHOOK" >/dev/null && echo -e "${C_GREEN}[✓] Discord alert sent!${C_RESET}"
            fi
            if [ -n "$TELEGRAM_BOT_TOKEN" ] && [ -n "$TELEGRAM_CHAT_ID" ]; then
                curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" -d "chat_id=${TELEGRAM_CHAT_ID}&text=${msg}" >/dev/null && echo -e "${C_GREEN}[✓] Telegram alert sent!${C_RESET}"
            fi
            ;;
        *)
            echo -e "${C_RED}[!] Usage: serverctl notify [setup|test]${C_RESET}"
            ;;
    esac
}

# Network Speedtest
cmd_speedtest() {
    echo -e "${C_CYAN}[*] Measuring server network latency and download speed...${C_RESET}"
    local ping_ms
    ping_ms=$(ping -c 3 1.1.1.1 2>/dev/null | tail -1 | awk -F '/' '{print $5}' || echo "N/A")
    echo -e "Ping to Cloudflare DNS (1.1.1.1): ${C_GREEN}${ping_ms} ms${C_RESET}"

    if command -v speedtest >/dev/null 2>&1; then
        speedtest
    elif command -v speedtest-cli >/dev/null 2>&1; then
        speedtest-cli --simple
    else
        echo -e "${C_CYAN}[*] Testing raw download speed via fast CDN...${C_RESET}"
        curl -s -w 'Downloaded: %{size_download} bytes in %{time_total} seconds (%{speed_download} bytes/sec)\n' -o /dev/null https://speed.cloudflare.com/__down?bytes=25000000 || echo "Speedtest unavailable."
    fi
}

# Logs Viewer
cmd_logs() {
    local target="${1:-ssh}"
    case "$target" in
        ssh)
            journalctl -u ssh -u sshd -n 50 -f 2>/dev/null || tail -n 50 -f /var/log/auth.log 2>/dev/null || tail -n 50 -f /var/log/secure
            ;;
        fail2ban)
            journalctl -u fail2ban -n 50 -f 2>/dev/null || tail -n 50 -f /var/log/fail2ban.log
            ;;
        watchdog)
            journalctl -u server-watchdog -n 50 -f
            ;;
        thermal)
            journalctl -u server-thermal-guard -n 50 -f
            ;;
        *)
            echo -e "${C_RED}[!] Usage: serverctl logs [ssh|fail2ban|watchdog|thermal]${C_RESET}"
            ;;
    esac
}

# Full Uninstaller & System Restoration
cmd_uninstall() {
    require_root
    echo -e "${C_RED}${C_BOLD}"
    echo "=================================================================="
    echo "       SERVER-MY-PC UNINSTALLER & SYSTEM RESTORATION              "
    echo "=================================================================="
    echo -e "${C_RESET}"
    read -r -p "Are you sure you want to revert power/lid settings and uninstall server-my-pc? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "${C_YELLOW}[*] Uninstall cancelled.${C_RESET}"
        exit 0
    fi

    echo -e "${C_CYAN}[*] Unmasking systemd power and sleep targets...${C_RESET}"
    systemctl unmask sleep.target suspend.target hibernate.target hybrid-sleep.target >/dev/null 2>&1 || true

    echo -e "${C_CYAN}[*] Removing 24/7 lid-close override and restoring normal laptop sleep...${C_RESET}"
    rm -f /etc/systemd/logind.conf.d/99-server-my-pc.conf
    systemctl restart systemd-logind 2>/dev/null || systemctl kill -s HUP systemd-logind 2>/dev/null || true

    echo -e "${C_CYAN}[*] Stopping and disabling watchdog and thermal daemons...${C_RESET}"
    systemctl disable --now server-watchdog.timer server-watchdog.service server-thermal-guard.service >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/server-watchdog.* /etc/systemd/system/server-thermal-guard.*
    rm -f /usr/local/bin/server-watchdog /usr/local/bin/server-thermal-guard

    echo -e "${C_CYAN}[*] Removing custom sysctl tuning...${C_RESET}"
    rm -f /etc/sysctl.d/99-server-my-pc.conf
    sysctl --system >/dev/null 2>&1 || true

    echo -e "${C_CYAN}[*] Cleaning up configuration directory...${C_RESET}"
    rm -rf "$CONFIG_DIR"

    echo -e "${C_GREEN}[✓] System successfully reverted to normal laptop/desktop defaults!${C_RESET}"
    echo -e "${C_DIM}Note: OpenSSH, Docker, and Cockpit were left installed so you don't lose apps. You can remove them with your package manager if desired.${C_RESET}"
    rm -f /usr/local/bin/serverctl /usr/local/bin/server-my-pc
}

# Persistence & Boot Stickiness Telemetry
cmd_persistence() {
    show_banner
    echo -e "${C_WHITE}${C_BOLD}=== 24/7 AUTO-BOOT & STICKINESS TELEMETRY ===${C_RESET}\n"

    local boot_svc="Inactive"
    if systemctl is-enabled --quiet server-my-pc-boot.service 2>/dev/null; then
        boot_svc="${C_GREEN}ENABLED (Re-applies all settings on every startup)${C_RESET}"
    fi
    echo -e "Boot Persistence Engine: $boot_svc"

    local sleep_status="Normal"
    if systemctl is-masked --quiet sleep.target 2>/dev/null; then
        sleep_status="${C_GREEN}MASKED (Cannot sleep/suspend under any condition)${C_RESET}"
    fi
    echo -e "System Sleep Targets   : $sleep_status"

    local lid_status="Normal"
    if [ -f /etc/systemd/logind.conf.d/99-server-my-pc.conf ] && grep -q "HandleLidSwitch=ignore" /etc/systemd/logind.conf.d/99-server-my-pc.conf 2>/dev/null; then
        lid_status="${C_GREEN}Lid Close Ignored (Always ON 24/7)${C_RESET}"
    fi
    echo -e "Laptop Lid Policy      : $lid_status"

    local tunnel_auto="Disabled"
    if [ -f "${CONFIG_DIR}/tunnel.enabled" ]; then
        tunnel_auto="${C_GREEN}ENABLED (Tunnel resumes automatically after reboot)${C_RESET}"
    fi
    echo -e "CGNAT Tunnel Auto-Start: $tunnel_auto"

    local watchdog_status="Inactive"
    if systemctl is-enabled --quiet server-watchdog.timer 2>/dev/null; then
        watchdog_status="${C_GREEN}ACTIVE (Pings gateway every 60s, auto-reconnects)${C_RESET}"
    fi
    echo -e "Network Watchdog       : $watchdog_status"

    local docker_auto="N/A"
    if command -v docker >/dev/null 2>&1; then
        local count
        count=$(docker ps -a --filter "restart=always" --format '{{.Names}}' 2>/dev/null | wc -l)
        docker_auto="${C_GREEN}${count} container(s) configured with --restart=always${C_RESET}"
    fi
    echo -e "Docker Container Auto  : $docker_auto"

    echo -e "\n${C_BOLD}Power Cut & Cold-Boot Auto Power On (BIOS):${C_RESET}"
    echo -e "  To make your computer automatically turn ON when wall power is plugged in/restored:"
    echo -e "  Run: ${C_CYAN}serverctl bios${C_RESET} for step-by-step motherboard instructions.\n"
}

