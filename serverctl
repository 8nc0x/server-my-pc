    trap "clear; exit 0" INT TERM

    while true; do
        tput cup 0 0
        echo -e "${C_CYAN}${C_BOLD}=== SERVER-MY-PC REAL-TIME DASHBOARD === (${C_WHITE}$(date '+%Y-%m-%d %H:%M:%S')${C_CYAN}) ===${C_RESET}"
        echo -e "${C_DIM}Press Ctrl+C to exit dashboard.${C_RESET}\n"

        local local_ip uptime_str temp bat ram_usage disk_usage cpu_load
        local_ip=$(get_local_ip)
        uptime_str=$(uptime -p 2>/dev/null || uptime | awk '{print $3,$4}')
        temp=$(get_cpu_temp)
        bat=$(get_battery_info)
        ram_usage=$(free -h 2>/dev/null | awk '/Mem:/ {print $3 "/" $2 " (" int($3/$2*100) "%)"}')
        disk_usage=$(df -h / 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')
        cpu_load=$(awk '{print $1", "$2", "$3}' /proc/loadavg 2>/dev/null || echo "N/A")

        echo -e "${C_WHITE}${C_BOLD}Telemetry:${C_RESET}"
        printf "  %-18s: ${C_GREEN}%-20s${C_RESET}  %-18s: ${C_YELLOW}%-20s${C_RESET}\n" "IP Address" "$local_ip" "Load (1/5/15)" "$cpu_load"
        printf "  %-18s: ${C_BLUE}%-20s${C_RESET}  %-18s: ${C_MAGENTA}%-20s${C_RESET}\n" "RAM Usage" "$ram_usage" "Disk (/)" "$disk_usage"
        printf "  %-18s: ${C_CYAN}%-20s${C_RESET}  %-18s: ${C_WHITE}%-20s${C_RESET}\n" "CPU Temp" "$temp" "Battery/AC" "$bat"
        printf "  %-18s: ${C_GREEN}%-20s${C_RESET}\n" "Uptime" "$uptime_str"

        echo -e "\n${C_WHITE}${C_BOLD}Active SSH Logins:${C_RESET}"
        who 2>/dev/null | awk '{printf "  " "\033[38;5;46m" "%-12s" "\033[0m" " from %-18s at %s %s\n", $1, $5, $3, $4}' || echo "  None"

        echo -e "\n${C_WHITE}${C_BOLD}Docker Containers (Top 5):${C_RESET}"
        if command -v docker >/dev/null 2>&1 && systemctl is-active --quiet docker 2>/dev/null; then
            docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null | head -n 6 | sed 's/^/  /' || echo "  Docker is running (no containers)"
        else
            echo -e "  ${C_DIM}Docker not installed or not running.${C_RESET}"
        fi

        echo -e "\n${C_WHITE}${C_BOLD}Security & Fail2ban Status:${C_RESET}"
        if command -v fail2ban-client >/dev/null 2>&1 && systemctl is-active --quiet fail2ban 2>/dev/null; then
            local banned
            banned=$(fail2ban-client status sshd 2>/dev/null | grep "Currently banned:" | awk '{print $NF}' || echo "0")
            echo -e "  Fail2ban SSH Jail: ${C_GREEN}Active${C_RESET} | Currently Banned Attackers: ${C_RED}${banned}${C_RESET}"
        else
            echo -e "  ${C_DIM}Fail2ban not active.${C_RESET}"
        fi

        sleep 2
    done
}

# Firewall Port Management
cmd_open_port() {
    require_root
    local port="$1"
    local proto="${2:-tcp}"

    if [ -z "$port" ]; then
        echo -e "${C_RED}[!] Usage: serverctl open-port <port_number> [tcp|udp]${C_RESET}"
        exit 1
    fi

    echo -e "${C_CYAN}[*] Opening port ${port}/${proto} in firewall...${C_RESET}"
    if command -v ufw >/dev/null 2>&1; then
        ufw allow "${port}/${proto}"
        echo -e "${C_GREEN}[✓] Port ${port}/${proto} opened in UFW.${C_RESET}"
    elif command -v firewall-cmd >/dev/null 2>&1; then
        firewall-cmd --permanent --add-port="${port}/${proto}"
        firewall-cmd --reload
        echo -e "${C_GREEN}[✓] Port ${port}/${proto} opened in firewalld.${C_RESET}"
    elif command -v iptables >/dev/null 2>&1; then
        iptables -I INPUT -p "${proto}" --dport "${port}" -j ACCEPT
        echo -e "${C_GREEN}[✓] Port ${port}/${proto} opened in iptables.${C_RESET}"
    else
        echo -e "${C_YELLOW}[!] No supported firewall detected (UFW/firewalld/iptables).${C_RESET}"
    fi

    # Attempt UPnP router port forward
    if command -v upnpc >/dev/null 2>&1; then
        local local_ip
        local_ip=$(get_local_ip)
        echo -e "${C_CYAN}[*] Requesting UPnP router port forward for ${port}...${C_RESET}"
        upnpc -a "$local_ip" "$port" "$port" "$proto" >/dev/null 2>&1 || true
    fi
}

cmd_close_port() {
    require_root
    local port="$1"
    local proto="${2:-tcp}"

    if [ -z "$port" ]; then
        echo -e "${C_RED}[!] Usage: serverctl close-port <port_number> [tcp|udp]${C_RESET}"
        exit 1
    fi

    echo -e "${C_CYAN}[*] Closing port ${port}/${proto} in firewall...${C_RESET}"
    if command -v ufw >/dev/null 2>&1; then
        ufw delete allow "${port}/${proto}"
        echo -e "${C_GREEN}[✓] Port ${port}/${proto} closed in UFW.${C_RESET}"
    elif command -v firewall-cmd >/dev/null 2>&1; then
        firewall-cmd --permanent --remove-port="${port}/${proto}"
        firewall-cmd --reload
        echo -e "${C_GREEN}[✓] Port ${port}/${proto} closed in firewalld.${C_RESET}"
    elif command -v iptables >/dev/null 2>&1; then
        iptables -D INPUT -p "${proto}" --dport "${port}" -j ACCEPT 2>/dev/null || true
        echo -e "${C_GREEN}[✓] Port ${port}/${proto} closed in iptables.${C_RESET}"
    fi

    if command -v upnpc >/dev/null 2>&1; then
        upnpc -d "$port" "$proto" >/dev/null 2>&1 || true
    fi
}

# Lid Management
cmd_lid() {
    require_root
    local action="$1"
    local conf="/etc/systemd/logind.conf.d/99-server-my-pc.conf"
    mkdir -p "/etc/systemd/logind.conf.d"

    case "$action" in
        ignore|server|on)
            cat > "$conf" << "EOF"
[Login]
HandleLidSwitch=ignore
HandleLidSwitchExternalPower=ignore
HandleLidSwitchDocked=ignore
LidSwitchIgnoreInhibited=no
IdleAction=ignore
HandleSuspendKey=ignore
HandleHibernateKey=ignore
EOF
            systemctl restart systemd-logind 2>/dev/null || systemctl kill -s HUP systemd-logind 2>/dev/null || true
            systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target >/dev/null 2>&1 || true
            echo -e "${C_GREEN}[✓] 24/7 Lid-Close sleep is DISABLED. The PC will stay active 24/7 even with lid shut.${C_RESET}"
            ;;
        normal|laptop|off)
            rm -f "$conf"
            systemctl unmask sleep.target suspend.target hibernate.target hybrid-sleep.target >/dev/null 2>&1 || true
            systemctl restart systemd-logind 2>/dev/null || systemctl kill -s HUP systemd-logind 2>/dev/null || true
            echo -e "${C_YELLOW}[✓] Normal laptop lid behavior RESTORED. System will sleep when lid closes.${C_RESET}"
            ;;
        status|"")
            if [ -f "$conf" ] && grep -q "HandleLidSwitch=ignore" "$conf"; then
                echo -e "${C_GREEN}● Current Lid State: SERVER MODE (Lid close is ignored, stays 24/7 awake)${C_RESET}"
            else
                echo -e "${C_YELLOW}○ Current Lid State: NORMAL MODE (Sleeps on lid close)${C_RESET}"
            fi
            ;;
        *)
            echo -e "${C_RED}[!] Usage: serverctl lid [ignore|normal|status]${C_RESET}"
            ;;
    esac
}

# Battery Health Management
cmd_battery() {
    local action="$1"
    local val="$2"
    local threshold_file=""

    for f in /sys/class/power_supply/BAT*/charge_control_limit_max /sys/class/power_supply/BAT*/charge_start_threshold; do
        if [ -f "$f" ]; then
            threshold_file="$f"
            break
        fi
    done

    case "$action" in
        status|"")
            echo -e "${C_BOLD}=== Battery Health & Threshold Status ===${C_RESET}"
            get_battery_info
            if [ -n "$threshold_file" ]; then
                echo -e "Hardware Charge Limit Supported: ${C_GREEN}YES${C_RESET} (${threshold_file})"
                echo -e "Current Limit: $(cat "$threshold_file")%"
            else
                echo -e "Hardware Charge Limit Supported: ${C_YELLOW}Not exposed by current ACPI driver${C_RESET}"
            fi
            ;;
        limit|set)
            require_root
            if [ -z "$val" ]; then
                echo -e "${C_RED}[!] Usage: serverctl battery limit <percent (e.g. 80)>${C_RESET}"
                exit 1
            fi
            if [ -n "$threshold_file" ]; then
                echo "$val" > "$threshold_file"
                echo -e "${C_GREEN}[✓] Battery charge threshold set to ${val}%. Laptop battery will not overcharge.${C_RESET}"
            else
                echo -e "${C_YELLOW}[!] Battery charge control file not exposed by this laptop motherboard.${C_RESET}"
            fi
            ;;
        *)
            echo -e "${C_RED}[!] Usage: serverctl battery [status|limit <percent>]${C_RESET}"
            ;;
    esac
}

# Zero-Signup CGNAT Tunnel Helper (Direct TCP without client software)
cmd_tunnel() {
    local action="${1:-status}"
    local port="${SSH_PORT:-22}"
    [ -f "${CONFIG_DIR}/ssh_port" ] && port=$(cat "${CONFIG_DIR}/ssh_port")

    case "$action" in
        start)
            require_root
            echo -e "${C_CYAN}[*] Starting zero-signup encrypted TCP tunnel for remote access...${C_RESET}"

            systemctl stop server-tunnel.service 2>/dev/null || true
            pkill -f "a.pinggy.io" 2>/dev/null || true
            mkdir -p "$CONFIG_DIR"
            touch "${CONFIG_DIR}/tunnel.enabled"

            # Create systemd service for 24/7 auto-restart & persistence across reboots
            cat > /etc/systemd/system/server-tunnel.service << EOF
[Unit]
Description=server-my-pc Zero-Config Remote SSH Tunnel
After=network.target ssh.service sshd.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/ssh -p 443 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -R0:localhost:${port} a.pinggy.io
Restart=always
RestartSec=5
StandardOutput=file:/var/log/server-my-pc-tunnel.log
StandardError=file:/var/log/server-my-pc-tunnel.log

[Install]
WantedBy=multi-user.target
EOF
            systemctl daemon-reload
            systemctl enable --now server-tunnel.service >/dev/null 2>&1

            echo -e "${C_YELLOW}[*] Negotiating public TCP tunnel port...${C_RESET}"
            sleep 4

            local tunnel_cmd=""
            if [ -f /var/log/server-my-pc-tunnel.log ]; then
                tunnel_cmd=$(grep -oE 'ssh -p [0-9]+ [a-zA-Z0-9._-]+@[a-zA-Z0-9.-]+' /var/log/server-my-pc-tunnel.log | head -n1 || echo "")
            fi

            if [ -n "$tunnel_cmd" ]; then
                echo -e "\n${C_GREEN}${C_BOLD}========================================================================${C_RESET}"
                echo -e "  ${C_GREEN}${C_BOLD}⚡ ZERO-CONFIG REMOTE INTERNET ACCESS IS NOW LIVE! ⚡${C_RESET}"
                echo -e "${C_GREEN}${C_BOLD}========================================================================${C_RESET}"
                echo -e "  ${C_WHITE}You can connect from ${C_BOLD}ANYWHERE IN THE WORLD${C_RESET} (Cellular, Hotspot, Office):"
                echo -e "  ${C_CYAN}${C_BOLD}► Remote SSH Command :${C_RESET} ${C_GREEN}${C_BOLD}${tunnel_cmd}${C_RESET}"
                echo -e "  ${C_DIM}(Works from any standard Windows CMD/PowerShell without installing extra software!)${C_RESET}\n"
            else
                echo -e "${C_GREEN}[✓] Remote tunnel daemon started in background.${C_RESET}"
                echo -e "Run ${C_CYAN}serverctl tunnel status${C_RESET} to display the public SSH command."
            fi
            ;;
        stop)
            require_root
            rm -f "${CONFIG_DIR}/tunnel.enabled"
            systemctl disable --now server-tunnel.service 2>/dev/null || true
            pkill -f "a.pinggy.io" 2>/dev/null || true
            echo -e "${C_GREEN}[✓] Remote tunnel stopped and autostart disabled.${C_RESET}"
            ;;
        status)
            if systemctl is-active --quiet server-tunnel.service 2>/dev/null || pgrep -f "a.pinggy.io" >/dev/null 2>&1; then
                echo -e "${C_GREEN}● Remote Tunnel: ACTIVE & RUNNING${C_RESET}"
                if [ -f /var/log/server-my-pc-tunnel.log ]; then
                    local cmd
                    cmd=$(grep -oE 'ssh -p [0-9]+ [a-zA-Z0-9._-]+@[a-zA-Z0-9.-]+' /var/log/server-my-pc-tunnel.log | tail -n1 || echo "")
                    if [ -n "$cmd" ]; then
                        echo -e "► Remote SSH Command: ${C_GREEN}${C_BOLD}${cmd}${C_RESET}"
                    else
                        echo -e "${C_DIM}Tunnel is active. View logs: tail -n 20 /var/log/server-my-pc-tunnel.log${C_RESET}"
                    fi
                fi
            else
                echo -e "${C_YELLOW}○ Remote Tunnel: INACTIVE${C_RESET}"
                echo -e "Run: ${C_CYAN}sudo serverctl tunnel start${C_RESET} to enable 24/7 internet access without router port forward."
            fi
            ;;
        *)
            echo -e "${C_RED}[!] Usage: serverctl tunnel [start|stop|status]${C_RESET}"
            ;;
    esac
}

# 1-Click App Catalog
cmd_apps() {
    local action="$1"
    local app="$2"

    if ! command -v docker >/dev/null 2>&1; then
        echo -e "${C_RED}[!] Error: Docker is not installed on this system.${C_RESET}"
        echo -e "${C_YELLOW}[*] To install Docker, re-run setup.sh or install via your package manager.${C_RESET}"
        exit 1
    fi

    case "$action" in
        list|"")
            echo -e "${C_WHITE}${C_BOLD}=== 1-CLICK DOCKER APP CATALOG ===${C_RESET}\n"
            printf "${C_CYAN}%-20s${C_WHITE} : %-50s\n" "portainer" "Web-based Docker container management UI (Port 9443/9000)"
            printf "${C_CYAN}%-20s${C_WHITE} : %-50s\n" "nginx-proxy-manager" "Visual reverse proxy with automated free SSL certificates (Port 81)"
            printf "${C_CYAN}%-20s${C_WHITE} : %-50s\n" "filebrowser" "Web file manager to upload/download files via browser (Port 8080)"
            printf "${C_CYAN}%-20s${C_WHITE} : %-50s\n" "uptime-kuma" "Self-hosted uptime and service monitoring dashboard (Port 3001)"
            printf "${C_CYAN}%-20s${C_WHITE} : %-50s\n" "wireguard-easy" "One-click WireGuard VPN with web UI management (Port 51820/51821)"
            echo -e "\n${C_DIM}Run: sudo serverctl apps install <app_name>${C_RESET}"
            ;;
        install)
            require_root
            local local_ip
            local_ip=$(get_local_ip)

            case "$app" in
                portainer)
                    echo -e "${C_CYAN}[*] Deploying Portainer Community Edition...${C_RESET}"
                    docker volume create portainer_data >/dev/null
                    docker run -d -p 8000:8000 -p 9443:9443 -p 9000:9000 --name portainer --restart=always -v /var/run/docker.sock:/var/run/docker.sock -v portainer_data:/data portainer/portainer-ce:latest
                    cmd_open_port 9443 tcp
                    cmd_open_port 9000 tcp
