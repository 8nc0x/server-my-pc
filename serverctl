    echo -e "\n${C_BOLD}2. Remote / Internet Access:${C_RESET}"
    if [ "$ssh_port" -eq 22 ]; then
        echo -e "   ${C_CYAN}ssh ${user}@${public_ip}${C_RESET}"
    else
        echo -e "   ${C_CYAN}ssh -p ${ssh_port} ${user}@${public_ip}${C_RESET}"
