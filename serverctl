    local local_ip public_ip ssh_port user
    local_ip=$(get_local_ip)
    public_ip=$(get_public_ip)
    user=$(whoami)
    ssh_port=22
    if [ -f /etc/ssh/sshd_config ]; then
        local p
        p=$(grep -E '^[[:space:]]*Port[[:space:]]+' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null | tail -n1 | awk '{print $2}')
