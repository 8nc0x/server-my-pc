                    docker run -d --name nginx-proxy-manager --restart=always -p 80:80 -p 81:81 -p 443:443 -v /opt/npm/data:/data -v /opt/npm/letsencrypt:/etc/letsencrypt jc21/nginx-proxy-manager:latest
                    cmd_open_port 80 tcp
                    cmd_open_port 81 tcp
                    cmd_open_port 443 tcp
                    echo -e "${C_GREEN}[✓] Nginx Proxy Manager deployed! Access admin UI at:${C_RESET} ${C_BOLD}http://${local_ip}:81${C_RESET} (Default: admin@example.com / changeme)"
                    ;;
                filebrowser)
                    echo -e "${C_CYAN}[*] Deploying FileBrowser Web File Manager...${C_RESET}"
                    mkdir -p /opt/filebrowser/srv /opt/filebrowser/config
                    touch /opt/filebrowser/config/filebrowser.db
                    docker run -d --name filebrowser --restart=always -v /:/srv -v /opt/filebrowser/config/filebrowser.db:/database/filebrowser.db -p 8080:80 filebrowser/filebrowser:latest
