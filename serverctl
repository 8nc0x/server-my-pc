#!/usr/bin/env bash
# ==============================================================================
# serverctl - Unified Bare-Metal Server Management CLI & Live Dashboard
# Part of server-my-pc (https://github.com/8nc0x/server-my-pc)
# ==============================================================================

set -e

# Version
VERSION="1.0.0"

# Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RED="\033[38;5;196m"
C_GREEN="\033[38;5;46m"
C_YELLOW="\033[38;5;226m"
C_BLUE="\033[38;5;39m"
C_MAGENTA="\033[38;5;201m"
C_CYAN="\033[38;5;51m"
C_WHITE="\033[38;5;231m"
C_GRAY="\033[38;5;244m"
C_BG_BLUE="\033[48;5;24m"
C_BG_DARK="\033[48;5;235m"

CONFIG_DIR="/etc/server-my-pc"
NOTIFY_CONFIG="${CONFIG_DIR}/notify.conf"
PRESET_FILE="${CONFIG_DIR}/preset"
BACKUP_DIR="/var/backups/server-my-pc"

# Ensure root for administrative commands
require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "${C_RED}[!] Error:${C_RESET} This command requires administrative privileges."
        echo -e "${C_YELLOW}[*] Please run:${C_RESET} sudo serverctl $*"
        exit 1
    fi
}

# Banner
show_banner() {
    echo -e "${C_CYAN}${C_BOLD}"
    cat << "EOF"
  ____                                __  __           ____   ____ 
 / ___|  ___ _ ____   _____ _ __     |  \/  |_   _    |  _ \ / ___|
 \___ \ / _ \ '__\ \ / / _ \ '__|____| |\/| | | | |___| |_) | |    
  ___) |  __/ |   \ V /  __/ | |_____| |  | | |_| |___|  __/| |___ 
 |____/ \___|_|    \_/ \___|_|       |_|  |_|\__, |   |_|    \____|
                                             |___/                 
EOF
    echo -e "${C_RESET}${C_DIM}             Next-Gen 24/7 PC & Laptop Server Control - v${VERSION}${C_RESET}\n"
}

# Detect Network IPs
get_local_ip() {
    local ip
    ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}')
    if [ -z "$ip" ]; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi
    [ -z "$ip" ] && ip="127.0.0.1"
    echo "$ip"
}

get_public_ip() {
    local ip
    ip=$(curl -s --max-time 2 https://api.ipify.org 2>/dev/null || curl -s --max-time 2 https://ifconfig.me 2>/dev/null || curl -s --max-time 2 https://icanhazip.com 2>/dev/null || echo "Unknown/Offline")
    echo "$ip"
}

# Thermal Information
get_cpu_temp() {
    local temp="N/A"
    if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
        local raw
        raw=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
        if [ -n "$raw" ] && [ "$raw" -gt 0 ] 2>/dev/null; then
            temp="$((raw / 1000))°C"
        fi
    elif command -v sensors >/dev/null 2>&1; then
        local s
        s=$(sensors 2>/dev/null | grep -E -m1 '(Core 0|Package id 0|Tctl|CPU Temp):' | awk '{print $2}' | tr -d '+')
        [ -n "$s" ] && temp="$s"
    fi
    echo "$temp"
}

# Battery Information
get_battery_info() {
    local bat_path=""
    for b in /sys/class/power_supply/BAT* /sys/class/power_supply/battery; do
        if [ -d "$b" ]; then
            bat_path="$b"
            break
        fi
    done

    if [ -n "$bat_path" ] && [ -f "$bat_path/capacity" ]; then
        local cap status
        cap=$(cat "$bat_path/capacity" 2>/dev/null)
        status=$(cat "$bat_path/status" 2>/dev/null)
        echo "${cap}% (${status})"
    else
        echo "AC Desktop / No Battery"
    fi
}

# Check Service Status
check_service() {
    local svc="$1"
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        echo -e "${C_GREEN}● ACTIVE${C_RESET}"
    elif systemctl is-enabled --quiet "$svc" 2>/dev/null; then
        echo -e "${C_YELLOW}○ INACTIVE${C_RESET}"
    else
        echo -e "${C_RED}✕ NOT INSTALLED${C_RESET}"
    fi
}

# Status Command
cmd_status() {
    show_banner

    local local_ip public_ip uptime_str os_name cpu_load ram_usage disk_usage temp bat
    local_ip=$(get_local_ip)
    public_ip=$(get_public_ip)
    uptime_str=$(uptime -p 2>/dev/null | sed 's/up //' || uptime | awk '{print $3,$4}' | tr -d ',')
    
    if [ -f /etc/os-release ]; then
        os_name=$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d= -f2 | tr -d '"')
    else
        os_name="$(uname -s) $(uname -r)"
    fi

    cpu_load=$(awk '{print $1", "$2", "$3}' /proc/loadavg 2>/dev/null || echo "N/A")
    ram_usage=$(free -h 2>/dev/null | awk '/Mem:/ {print $3 "/" $2}')
    disk_usage=$(df -h / 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')
    temp=$(get_cpu_temp)
    bat=$(get_battery_info)

    local preset="standard"
    [ -f "$PRESET_FILE" ] && preset=$(cat "$PRESET_FILE")

    echo -e "${C_WHITE}${C_BOLD}┌── SYSTEM TELEMETRY ────────────────────────────────────────────────────────┐${C_RESET}"
    printf "${C_WHITE}│  %-24s: ${C_CYAN}%-45s${C_WHITE}│\n" "Operating System" "$os_name"
    printf "${C_WHITE}│  %-24s: ${C_GREEN}%-45s${C_WHITE}│\n" "Uptime" "$uptime_str"
    printf "${C_WHITE}│  %-24s: ${C_YELLOW}%-45s${C_WHITE}│\n" "Load Average (1/5/15)" "$cpu_load"
    printf "${C_WHITE}│  %-24s: ${C_BLUE}%-45s${C_WHITE}│\n" "Memory Usage" "$ram_usage"
    printf "${C_WHITE}│  %-24s: ${C_MAGENTA}%-45s${C_WHITE}│\n" "Storage (Root /)" "$disk_usage"
    printf "${C_WHITE}│  %-24s: ${C_CYAN}%-45s${C_WHITE}│\n" "CPU Temperature" "$temp"
    printf "${C_WHITE}│  %-24s: ${C_WHITE}%-45s${C_WHITE}│\n" "Power / Battery" "$bat"
    printf "${C_WHITE}│  %-24s: ${C_GREEN}%-45s${C_WHITE}│\n" "Installed Preset" "$preset"
    echo -e "${C_WHITE}├── 24/7 NETWORK & CONNECTIVITY ─────────────────────────────────────────────┤${C_RESET}"
    printf "${C_WHITE}│  %-24s: ${C_GREEN}%-45s${C_WHITE}│\n" "Local LAN IP" "$local_ip"
    printf "${C_WHITE}│  %-24s: ${C_YELLOW}%-45s${C_WHITE}│\n" "Public WAN IP" "$public_ip"
    printf "${C_WHITE}│  %-24s: ${C_CYAN}%-45s${C_WHITE}│\n" "SSH Connection (Local)" "ssh $(whoami)@$local_ip"
    printf "${C_WHITE}│  %-24s: ${C_MAGENTA}%-45s${C_WHITE}│\n" "SSH Connection (Public)" "ssh $(whoami)@$public_ip"
    if systemctl is-active --quiet cockpit.socket 2>/dev/null; then
        printf "${C_WHITE}│  %-24s: ${C_BLUE}%-45s${C_WHITE}│\n" "Cockpit Web Console" "https://$local_ip:9090"
    fi
    echo -e "${C_WHITE}├── CORE SERVICES HEALTH ────────────────────────────────────────────────────┤${C_RESET}"
    
    local ssh_status fail2ban_status watchdog_status thermal_status docker_status
    ssh_status=$(check_service ssh || check_service sshd)
    fail2ban_status=$(check_service fail2ban)
    watchdog_status=$(check_service server-watchdog.timer || check_service server-watchdog)
    thermal_status=$(check_service server-thermal-guard)
    docker_status=$(check_service docker)

    printf "${C_WHITE}│  %-24s: %-54s${C_WHITE}│\n" "OpenSSH Server" "$ssh_status"
    printf "${C_WHITE}│  %-24s: %-54s${C_WHITE}│\n" "Fail2ban Defense" "$fail2ban_status"
    printf "${C_WHITE}│  %-24s: %-54s${C_WHITE}│\n" "Network Watchdog" "$watchdog_status"
    printf "${C_WHITE}│  %-24s: %-54s${C_WHITE}│\n" "Thermal Guard" "$thermal_status"
    printf "${C_WHITE}│  %-24s: %-54s${C_WHITE}│\n" "Docker Engine" "$docker_status"

    # Lid close status
    local lid_status="Active 24/7 (Sleep Inhibited)"
    if [ -f /etc/systemd/logind.conf.d/99-server-my-pc.conf ]; then
        if grep -q "HandleLidSwitch=ignore" /etc/systemd/logind.conf.d/99-server-my-pc.conf 2>/dev/null; then
            lid_status="${C_GREEN}Lid-Close Ignored (Always ON)${C_WHITE}"
        else
            lid_status="${C_YELLOW}Normal (Sleep on Lid Close)${C_WHITE}"
        fi
    fi
    printf "${C_WHITE}│  %-24s: %-54s${C_WHITE}│\n" "Lid-Close Policy" "$lid_status"
    echo -e "${C_WHITE}└────────────────────────────────────────────────────────────────────────────┘${C_RESET}"
}

